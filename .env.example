# Variables d'environnement de Cité Savante — voir docs/SPECIFICATIONS.md, section 18.
# Copier ce fichier en .env.local (jamais commité) et compléter les valeurs manquantes.

# URL publique du site, sans slash final (https://citesavante.com en production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL du projet Supabase (phase 1).
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique (anon) Supabase, utilisable côté navigateur (phase 1).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé de service Supabase : jamais côté client, uniquement dans le code serveur (phase 1).
SUPABASE_SERVICE_ROLE_KEY=

# Clé API Resend pour l'envoi des e-mails (phase 5).
RESEND_API_KEY=

# Adresse d'expédition des e-mails.
EMAIL_FROM="Cité Savante <notifications@citesavante.com>"

# Adresse de l'équipe de modération qui reçoit les notifications (phase 5).
ADMIN_NOTIFY_EMAIL=

# Cloudflare Turnstile, clé de site (côté navigateur). Valeurs ci-dessous : clés de test
# officielles Cloudflare, à remplacer en production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Cloudflare Turnstile, clé secrète (côté serveur). Clé de test officielle Cloudflare,
# à remplacer en production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Sel utilisé pour hacher les empreintes de formulaires (anti-spam, phase 5).
FORM_HASH_SALT=

# Protection des tâches planifiées (évolution P1).
CRON_SECRET=
